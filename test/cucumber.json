{
  "default": {
    "requireModule": [],
    "require": [
      "support/world.js",
      "support/hooks.js",
      "step-definitions/**/*.js"
    ],
    "format": [
      "progress",
      "json:reports/cucumber-report.json",
      "html:reports/cucumber-report.html"
    ],
    "formatOptions": {
      "snippetInterface": "async-await"
    },
    "dryRun": false,
    "failFast": false,
    "strict": true,
    "worldParameters": {
      "baseUrl": "http://localhost:3000",
      "apiUrl": "http://localhost:3001",
      "timeout": 60000
    }
  },
  "debug": {
    "requireModule": [],
    "require": [
      "support/world.js",
      "support/hooks.js",
      "step-definitions/**/*.js"
    ],
    "format": [
      "progress"
    ],
    "formatOptions": {
      "snippetInterface": "async-await"
    },
    "dryRun": false,
    "failFast": true,
    "strict": true,
    "worldParameters": {
      "baseUrl": "http://localhost:3000",
      "apiUrl": "http://localhost:3001",
      "timeout": 60000
    }
  }
}